# --- Build stage ---
FROM golang:1.25-alpine AS builder

WORKDIR /build

# 使用国内 Go 模块代理（解决 proxy.golang.org 不可达问题）
ENV GOPROXY=https://goproxy.cn,direct

# Copy go module files
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build
COPY . ./
RUN CGO_ENABLED=0 go build -o /sogame-server ./cmd/server

# --- Runtime stage ---
FROM alpine:3.20

# 使用国内 Alpine 镜像源（加速 apk 安装）
RUN sed -i 's|dl-cdn.alpinelinux.org|mirrors.aliyun.com|g' /etc/apk/repositories
RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app
COPY --from=builder /sogame-server /app/sogame-server

RUN mkdir -p /data /web

ENV SOGAME_DB_PATH=/data/sogame.db
ENV SOGAME_LISTEN=:8080
ENV SOGAME_WEB_DIR=/web

EXPOSE 8080

CMD ["/app/sogame-server"]
