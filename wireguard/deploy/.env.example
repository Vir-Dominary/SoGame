# SoGame 控制服务器部署配置
# 复制此文件为 .env 并修改各项值

# ========== 后端配置 ==========

# Admin Token（管理 API 认证令牌）
# 必须设置！为空时 /api/admin/* 端点将返回 403 禁用
# 建议使用随机字符串，如：openssl rand -hex 32
SOGAME_ADMIN_TOKEN=change-me-to-a-random-string

# ========== Nginx 配置 ==========

# Nginx 配置文件选择：
#   nginx.conf        — 仅 HTTP（开发/测试）
#   nginx-https.conf  — HTTPS + HTTP 重定向（生产环境）
NGINX_CONF=nginx.conf

# 端口映射（如已占用可修改）
HTTP_PORT=80
HTTPS_PORT=443

# ========== HTTPS 证书 ==========
# 启用 HTTPS 时，将证书文件放到 ./certs/ 目录下：
#   fullchain.pem  — 证书链
#   privkey.pem    — 私钥
# 可使用 Let's Encrypt 免费获取：https://certbot.eff.org/
