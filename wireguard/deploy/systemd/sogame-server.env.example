# SoGame 控制服务器环境变量
# 复制此文件到 /etc/sogame/server.env 并修改

# SQLite 数据库路径
SOGAME_DB_PATH=/var/lib/sogame/sogame.db

# HTTP 监听地址（:8080 表示所有接口的 8080 端口）
SOGAME_LISTEN=:8080

# 静态 Web UI 目录（可选，留空则不提供静态文件服务）
SOGAME_WEB_DIR=

# Admin Token（管理 API 认证令牌）
# 必须设置！为空时 /api/admin/* 端点将返回 403 禁用
# 生成随机 token：openssl rand -hex 32
SOGAME_ADMIN_TOKEN=change-me-to-a-random-string
